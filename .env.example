# Chat backend (Nitro server route at /api/chat). Server-only — these are read
# via runtimeConfig and never shipped to the client. Copy to `.env` and fill in.
#
# Local dev: use Ollama (no API key — run `ollama pull llama3.2`).
# Production: use Groq (free tier, 14,400 req/day — https://console.groq.com)
#             or Gemini (free tier — https://aistudio.google.com).
LLM_PROVIDER=ollama              # ollama | groq | gemini

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Eval harness (evals/, run with `pnpm eval` — see docs/EVALS.md). Uses
# GROQ_API_KEY above. The judge model must stay a DIFFERENT family than
# GROQ_MODEL (self-preference bias). It runs in plain JSON mode (not Groq's
# json_schema), so any Groq chat model works — alignment certifies the choice.
JUDGE_MODEL=llama-3.3-70b-versatile
# Hybrid local mode: EVAL_BOT_PROVIDER=ollama runs the bot on local Ollama
# (default model gpt-oss:20b — the open-weight release of the prod model, so
# local runs still grade the deployed pair; needs `ollama pull gpt-oss:20b`).
# The judge stays on Groq. Unlimited free reps; certify on Groq before deploy.
#EVAL_BOT_PROVIDER=ollama
#EVAL_BOT_MODEL=gpt-oss:20b
